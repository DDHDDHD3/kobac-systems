# Required: Neon PostgreSQL connection string.
# Replace every placeholder locally and never commit your .env file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# The local development server uses port 3000.
PORT="3000"

# Optional: server-side Gemini AI API key. Do not use a VITE_ variable.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional initial staff passwords. Use unique, strong values and keep them in .env only.
KOBAC_CEO_PASSWORD="REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD"
KOBAC_CDSO_PASSWORD="REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD"
KOBAC_OPS_PASSWORD="REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD"

# Optional application URL.
APP_URL="http://localhost:3000"

# Optional S3-compatible storage configuration.
NEON_API_REST_URL="YOUR_NEON_API_REST_URL"
AWS_ENDPOINT_URL_S3="YOUR_S3_ENDPOINT"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION="us-east-2"
